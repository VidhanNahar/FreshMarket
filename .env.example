# Arkiv Rabdi Testnet Access Key
# Get an access key from https://hub.arkiv.network/access-keys
# Restrict this public key to your allowed origin(s) (e.g. http://localhost:3000, your-app.vercel.app)
NEXT_PUBLIC_ARKIV_ACCESS_KEY=your_arkiv_access_key_here

# WalletConnect Cloud Project ID for RainbowKit
# Get a free project ID from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_wc_project_id

# Optional public reader key for independently hosted Storefront B. Restrict to its origin.
VITE_ARKIV_ACCESS_KEY=

# Swarm read gateways must match the network of your Bee upload node. Public values.
NEXT_PUBLIC_SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org
VITE_SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org

# Server-only upload configuration. Keep credentials out of NEXT_PUBLIC_/VITE_ variables.
SWARM_BEE_URL=
SWARM_POSTAGE_BATCH_ID=
SWARM_BEE_API_KEY=
SWARM_UPLOAD_ALLOWED_WALLETS=
SWARM_ALLOWED_ORIGIN=http://localhost:3000

# Server-only Redis-compatible REST state for atomic replay/quota protection.
# Required for Swarm uploads in production; local development uses process memory.
SWARM_UPLOAD_STATE_URL=
SWARM_UPLOAD_STATE_TOKEN=

# Phase 9: ENSv2 identity, Ethereum Sepolia ONLY (chain 11155111).
# Public RPC URL; browser-embedded provider keys must be origin restricted.
NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Defaults are pinned to shared/ens-deployment.json. Leave blank unless using a verified deployment.
NEXT_PUBLIC_ENS_ROOT_REGISTRY_ADDRESS=
NEXT_PUBLIC_ENS_ETH_REGISTRY_ADDRESS=
NEXT_PUBLIC_ENS_UNIVERSAL_RESOLVER_ADDRESS=
NEXT_PUBLIC_ENS_REVERSE_REGISTRAR_ADDRESS=
NEXT_PUBLIC_ENS_FACTORY_ADDRESS=
NEXT_PUBLIC_ENS_USER_REGISTRY_IMPLEMENTATION=
NEXT_PUBLIC_ENS_RESOLVER_IMPLEMENTATION=
# Set ONLY after your project wallet registers an actual second-level Sepolia .eth name.
# Do not assume freshmarket.eth is available or owned by the project.
NEXT_PUBLIC_ENS_PARENT_NAME=
# Optional pin: must equal the subregistry actually attached to the parent onchain.
NEXT_PUBLIC_ENS_SUBREGISTRY_ADDRESS=
