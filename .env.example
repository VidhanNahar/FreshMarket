# Arkiv Rabdi Testnet Access Key
# Get an access key from https://hub.arkiv.network/access-keys
# Restrict this public key to your allowed origin(s) (e.g. http://localhost:3000, your-app.vercel.app)
NEXT_PUBLIC_ARKIV_ACCESS_KEY=your_arkiv_access_key_here

# WalletConnect Cloud Project ID for RainbowKit
# Get a free project ID from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_wc_project_id

# Optional public reader key for independently hosted Storefront B. Restrict to its origin.
VITE_ARKIV_ACCESS_KEY=
